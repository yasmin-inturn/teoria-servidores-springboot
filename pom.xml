<?xml version="1.0" encoding="UTF-8"?>
<!--
  Build do projeto.

  O spring-boot-starter-parent traz o "dependency management": as versões de
  centenas de bibliotecas já vêm combinadas entre si, por isso nenhuma
  dependência abaixo declara <version>. O spring-boot-maven-plugin empacota
  tudo (classes + dependências + Tomcat) em um jar executável.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.8</version>
		<relativePath/>
	</parent>

	<groupId>br.com.loja</groupId>
	<artifactId>loja-virtual</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>loja-virtual</name>
	<description>Atividade pratica de servidores: Java + Spring Boot</description>

	<properties>
		<java.version>25</java.version>
	</properties>

	<dependencies>
		<!-- Spring MVC + Tomcat embarcado: e isto que faz do jar um servidor HTTP. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- Bean Validation (@Valid, @NotBlank, @Min) na borda da API. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Thymeleaf: renderiza a pagina de documentacao servida em GET /. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>

		<!-- Health check (/actuator/health): prova de que o Spring Boot ja vem
		     com ganchos de operacao, sem escrever nenhum codigo para isso. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Testes: JUnit 5 e MockMvc. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!--
			  Copia o proprio codigo-fonte para dentro do artefato, em
			  target/classes/fonte. E isso que permite a pagina de documentacao
			  exibir o codigo do servidor que a esta servindo, inclusive quando
			  roda como "java -jar" numa maquina sem a pasta do projeto.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<executions>
					<execution>
						<id>copiar-fontes-para-a-documentacao</id>
						<phase>process-resources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.outputDirectory}/fonte</outputDirectory>
							<resources>
								<resource>
									<directory>src/main/java</directory>
									<targetPath>java</targetPath>
								</resource>
								<resource>
									<directory>${project.basedir}</directory>
									<includes>
										<include>pom.xml</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
